# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/reliefconnect

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (for Firebase Auth verification + push notifications)
# Get these from your Firebase project's service account JSON
# (Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Set to "true" to use a mocked Firebase service instead of real Firebase Admin SDK
# Useful for local dev / grading without real Firebase credentials
FIREBASE_MOCK=true

# Secret needed to register an admin account via POST /api/auth/register
# (send it as "adminKey" in the body with role "admin"). `npm run seed` also creates an admin.
ADMIN_SIGNUP_KEY=change-me-admin-key

# CORS
CLIENT_ORIGIN=*
